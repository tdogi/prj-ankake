{
  "name": "@ankake/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:core && npm run test:ui",
    "test:core": "vitest run --config vitest.config.ts src/domain src/app src/cpu src/persistence",
    "test:ui": "vitest run --config vitest.config.ts src/ui",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ankake/cpu": "0.1.0",
    "@ankake/domain": "0.1.0",
    "@ankake/persistence": "0.1.0",
    "@ankake/ui": "0.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fast-check": "^3.23.2",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
